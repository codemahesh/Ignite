# Copy to .env and fill in. Local-dev defaults below match docker-compose.yml.
# See PS-2_Company_Brain_Architecture (1).md §6 for the full production var list.

# --- LLM (Cognee) ---
# Left blank on purpose: no real OpenAI key in local-first dev mode.
# When unset (or MOCK_LLM=true), the backend runs all LLM-dependent code
# (Cognee's own extraction, contradiction judge, topic classifier) through
# a deterministic mock provider instead of failing.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
MOCK_LLM=true

# --- Graph (local Neo4j via docker-compose) ---
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=local_dev_password

# --- Relational + vector (local Postgres+pgvector via docker-compose) ---
DB_PROVIDER=postgres
VECTOR_DB_PROVIDER=pgvector
DB_HOST=localhost
DB_PORT=5436
DB_NAME=company_brain
DB_USERNAME=cognee
DB_PASSWORD=cognee_local_dev
DATABASE_URL=postgresql://cognee:cognee_local_dev@localhost:5436/company_brain
# cognee 1.6.0's pgvector adapter falls back to DB_* only when backend access
# control is disabled (see ENABLE_BACKEND_ACCESS_CONTROL below); set these
# explicitly too so it works either way.
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5436
VECTOR_DB_NAME=company_brain
VECTOR_DB_USERNAME=cognee
VECTOR_DB_PASSWORD=cognee_local_dev

# cognee 1.6.0 defaults to multi-tenant auth ("authentication=required,
# multi_tenant=enabled") which the v1/v2 architecture docs don't assume and
# v2 §5.3 explicitly scopes out for this project (seam only, single tenant
# implemented). Disable it for local dev.
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- External search (optional, off by default) ---
TAVILY_API_KEY=

# --- Connector credential encryption (v2 §2.4) ---
# Local-dev-only key. Generate a real one for any non-local deploy:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=1DCegSP9vC3fnaUbLXJFl_eNlhB8RqRLiiH9hP4mSjk=

# --- Shared secret for mutating connector endpoints (BE-34) ---
ADMIN_SHARED_SECRET=local-dev-secret

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3010

# --- Local dev ports (8000 is already taken by other projects on this machine) ---
PORT=8010
